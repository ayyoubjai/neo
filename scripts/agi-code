#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

pick_python() {
  local candidates=()
  if [[ -n "${PYTHON:-}" ]]; then
    candidates+=("${PYTHON}")
  fi
  candidates+=("python3" "python")
  local candidate
  for candidate in "${candidates[@]}"; do
    if ! command -v "${candidate}" >/dev/null 2>&1; then
      continue
    fi
    if "${candidate}" -c "print('ok')" >/dev/null 2>&1; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

PYTHON_EXE="$(pick_python || true)"
if [[ -z "${PYTHON_EXE}" ]]; then
  echo "[agi-code] Python not found. Set PYTHON or install Python." >&2
  exit 1
fi

exec "${PYTHON_EXE}" "${SCRIPT_DIR}/agi_code.py" "$@"
