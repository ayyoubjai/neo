{
  "version": 1,
  "commands": [
    {
      "name": "build",
      "enabled": true,
      "command": "python scripts/evolve_metric_runner.py --metric syntax --target {target_path} --repo-root {run_dir}",
      "required": true,
      "weight": 0.2,
      "timeout_s": 120
    },
    {
      "name": "focused_tests",
      "enabled": true,
      "command": "python scripts/evolve_test_runner.py --target {target_path} --repo-root {run_dir} --max-files 8 --timeout-s 120",
      "parse_json": true,
      "required": true,
      "weight": 0.3,
      "timeout_s": 140
    },
    {
      "name": "safety",
      "enabled": true,
      "command": "python scripts/evolve_metric_runner.py --metric safety --target {target_path} --repo-root {run_dir} --baseline-root {repo_root}",
      "required": false,
      "weight": 0.1,
      "timeout_s": 120
    },
    {
      "name": "readability",
      "enabled": true,
      "command": "python scripts/evolve_metric_runner.py --metric readability --target {target_path} --repo-root {run_dir}",
      "required": false,
      "weight": 0.1,
      "timeout_s": 120
    },
    {
      "name": "behavioral",
      "enabled": true,
      "command": "python scripts/evolve_score.py --mode micro --macro-policy auto --auto-skip-no-input false --target {target_path} --target-start-line {target_start_line} --target-end-line {target_end_line} --repo-root {repo_root} --run-dir {run_dir} --micro-scenarios-file evolve/scenarios/llm/{target_key}.json --micro-autogenerate --min-cases 3 --min-correctness 0.95 --min-perf-ratio 0.95 --missing-source-policy fail",
      "parse_json": true,
      "required": true,
      "weight": 0.3,
      "timeout_s": 300
    }
  ],
  "benchmark": {
    "enabled": false,
    "name": "workload",
    "command": "python -m pytest -q",
    "required": false,
    "weight": 0.0,
    "timeout_s": 300,
    "warmups": 1,
    "runs": 5,
    "min_ratio": 0.95,
    "smaller_is_better": true
  }
}
