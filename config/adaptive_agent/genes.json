      },
      "payload": {
        "description": "Create and extract compressed workspace archives.",
        "bundles": ["tool_runtime_basic"],
        "tool_ids": ["archive.zip_create", "archive.zip_extract"]
      }
    },
    {
      "id": "tool.network.research",
      "type": "tool",
      "priority": 55,
      "purposes": ["research", "assistant", "coding"],
      "requires": {
        "device_classes": ["pc_small", "pc_medium", "pc_strong", "phone_strong"],
        "network": true
      },
      "payload": {
        "description": "Use web/search tools when the purpose profile allows network access.",
        "bundles": ["network_tools"],
        "tool_ids": ["net.search", "http.request"]
      }
    },
    {
      "id": "tool.phone.senses",
      "type": "tool",
      "priority": 70,
      "purposes": ["phone_companion", "assistant"],
      "requires": {
        "device_classes": ["phone_small", "phone_strong"],
        "android": true
      },
      "payload": {
        "description": "Phone or Android-adjacent actions using existing embodiment phone tools.",
        "bundles": ["phone_tools"],
        "tool_ids": [
          "embodiment.phone_screen_capture",
          "embodiment.phone_tap",
          "embodiment.phone_swipe",
          "embodiment.phone_type",
          "embodiment.phone_launch_app"
        ]
      }
    },
    {
      "id": "tool.vision.local",
      "type": "tool",
      "priority": 50,
      "purposes": ["assistant", "research", "automation"],
      "requires": {
        "device_classes": ["pc_medium", "pc_strong"],
        "min_ram_mb": 10000
      },
      "payload": {
        "description": "Use existing image/video/live-vision analysis tools.",
        "bundles": ["vision_tools"],
        "tool_ids": ["image.analyse", "video.analyse", "vision.observe"]
      }
    },
    {
      "id": "service.model.llama_cpp",
      "type": "service",
      "priority": 95,
      "purposes": ["assistant", "phone_companion", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["phone_tiny", "phone_small", "phone_strong", "pc_tiny", "pc_small"]
      },
      "payload": {
        "server_kind": "llama_cpp",
        "description": "Start one llama.cpp server directly for weak or simple local cells.",
        "bundles": ["model_runtime"],
        "termux_setup": [
          "pkg update",
          "pkg install -y git cmake clang",
          "git clone https://github.com/ggml-org/llama.cpp",
          "cmake -S llama.cpp -B llama.cpp/build -DLLAMA_CURL=OFF",
          "cmake --build llama.cpp/build --config Release -j"
        ]
      }
    },
    {
      "id": "service.model.llama_swap",
      "type": "service",
      "priority": 110,
      "purposes": ["assistant", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["pc_medium", "pc_strong"],
        "min_ram_mb": 10000
      },
      "payload": {
        "server_kind": "llama_swap",
        "description": "Start llama-swap so strong machines can route across several GGUF models.",
        "bundles": ["llama_swap"],
        "binary": "llama-swap",
        "config_path": "config/config.yaml",
        "listen": "localhost:8080"
      }
    },
    {
      "id": "service.autonomy.light",
      "type": "service",
      "priority": 50,
      "purposes": ["automation", "research"],
