{
  "genes": [
    {
      "id": "cognition.system0_only",
      "type": "cognition",
      "priority": 100,
      "purposes": ["assistant", "phone_companion", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["phone_tiny", "phone_small", "phone_strong", "pc_tiny"]
      },
      "payload": {
        "mode": "system0",
        "aliases": ["SYSTEM0"],
        "bundles": ["cognition_basic"],
        "description": "Fastest mode: one direct system0 pass, minimal tool loop.",
        "requested_mode": "SYSTEM0",
        "systems_enabled": ["SYSTEM0"],
        "settings_patch": {
          "orchestrator": {
            "cognition_force_system": "system0",
            "cognition_system0_max_steps": 1,
            "cognition_system1_max_steps": 1,
            "cognition_system2_max_steps": 1,
            "cognition_system3_enabled": false,
            "cognition_action_limit": 2,
            "cognition_trivial_query_target": "system0",
            "cognition_mode": "small"
          },
          "autonomy": {
            "requested_mode": "SYSTEM0",
            "enabled": false,
            "start_with_run_all": false
          }
        }
      }
    },
    {
      "id": "cognition.system0_system1",
      "type": "cognition",
      "priority": 100,
      "purposes": ["assistant", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["pc_small"]
      },
      "payload": {
        "mode": "system1",
        "aliases": ["SYSTEM1", "system0_system1"],
        "bundles": ["cognition_basic"],
        "description": "Small-PC mode: system0 for trivial turns and system1 for simple planning.",
        "requested_mode": "SYSTEM1",
        "systems_enabled": ["SYSTEM0", "SYSTEM1"],
        "settings_patch": {
          "orchestrator": {
            "cognition_force_system": "system1",
            "cognition_system0_max_steps": 1,
            "cognition_system1_max_steps": 3,
            "cognition_system2_max_steps": 1,
            "cognition_system3_enabled": false,
            "cognition_action_limit": 4,
            "cognition_trivial_query_target": "system0",
            "cognition_mode": "small"
          },
          "autonomy": {
            "requested_mode": "SYSTEM1",
            "enabled": false,
            "start_with_run_all": false
          }
        }
      }
    },
    {
      "id": "cognition.system0_system1_system2",
      "type": "cognition",
      "priority": 100,
      "purposes": ["assistant", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["pc_medium"]
      },
      "payload": {
        "mode": "system2",
        "aliases": ["SYSTEM2", "system0_system1_system2"],
        "bundles": ["cognition_basic"],
        "description": "Medium-PC mode: system0/system1 plus deeper system2 reasoning.",
        "requested_mode": "COGNITION",
        "systems_enabled": ["SYSTEM0", "SYSTEM1", "SYSTEM2"],
        "settings_patch": {
          "orchestrator": {
            "cognition_force_system": "",
            "cognition_system0_max_steps": 1,
            "cognition_system1_max_steps": 4,
            "cognition_system2_max_steps": 3,
            "cognition_system3_enabled": false,
            "cognition_action_limit": 6,
            "cognition_trivial_query_target": "system1"
          },
          "autonomy": {
            "requested_mode": "COGNITION",
            "enabled": false,
            "start_with_run_all": false
          }
        }
      }
    },
    {
      "id": "cognition.full_systems",
      "type": "cognition",
      "priority": 110,
      "purposes": ["assistant", "coding", "research", "automation"],
      "requires": {
        "device_classes": ["pc_strong"],
        "min_ram_mb": 24000
      },
      "payload": {
        "mode": "full",
        "aliases": ["SYSTEM3", "COGNITION", "all", "system0_system1_system2_system3"],
        "bundles": ["cognition_basic", "autonomy"],
        "description": "Strong-machine mode: system0, system1, system2, and system3 peer cognition.",
        "requested_mode": "COGNITION",
        "systems_enabled": ["SYSTEM0", "SYSTEM1", "SYSTEM2", "SYSTEM3"],
        "settings_patch": {
          "orchestrator": {
            "cognition_force_system": "",
            "cognition_system0_max_steps": 1,
            "cognition_system1_max_steps": 6,
            "cognition_system2_max_steps": 4,
            "cognition_system3_enabled": true,
            "cognition_system3_rounds": 1,
            "cognition_system3_parallel": true,
            "cognition_action_limit": 8,
            "cognition_trivial_query_target": "system1"
          },
          "autonomy": {
            "requested_mode": "COGNITION"
          }
        }
      }
    },
