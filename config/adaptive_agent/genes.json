    {
      "id": "tool.notes.local",
      "type": "tool",
      "priority": 80,
      "purposes": ["assistant", "phone_companion", "research", "coding"],
      "requires": {
        "device_classes": ["*"],
        "min_storage_free_mb": 20
      },
      "payload": {
        "description": "Read and write local notes inside the workspace.",
        "bundles": ["tool_runtime_basic"],
        "tool_ids": ["fs.read_file", "fs.write_file", "fs.list_dir", "fs.stat"]
      }
    },
    {
      "id": "tool.shell.execution",
      "type": "tool",
      "priority": 60,
      "purposes": ["coding", "automation", "research"],
      "requires": {
        "device_classes": ["phone_small", "phone_strong", "pc_small", "pc_medium", "pc_strong"],
        "min_ram_mb": 3000
      },
      "payload": {
        "description": "Run bounded local process commands through the existing tier-2 executor.",
        "bundles": ["tool_runtime_basic"],
        "tool_ids": ["proc.exec"]
      }
    },
    {
      "id": "tool.repo.index",
      "type": "tool",
      "priority": 75,
      "purposes": ["coding", "research"],
      "requires": {
        "device_classes": ["pc_small", "pc_medium", "pc_strong"],
        "min_ram_mb": 6000,
        "min_storage_free_mb": 500
      },
      "payload": {
        "description": "Index and search source repositories.",
        "bundles": ["coding_tools"],
        "tool_ids": ["fs.find", "fs.search_text", "git.status", "git.diff", "git.log"]
      }
    },
    {
      "id": "tool.archive.dna",
      "type": "tool",
      "priority": 65,
      "purposes": ["coding", "automation", "research"],
      "requires": {
        "device_classes": ["*"],
