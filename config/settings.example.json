  "video": {
    "transcription_enabled": true,
    "ffmpeg_binary": "ffmpeg"
  },
  "google": {
    "enabled": false,
    "oauth_client_source": "skip",
    "auto_google_authorize": false
  },
  "evolve": {},
  "autonomy": {
    "enabled": false,
    "knowledge_enabled": false,
    "knowledge_worker": {
      "collection": "library",
      "pause_s": 60,
      "max_plans_per_day": 4,
      "max_investigations_per_day": 4,
      "max_tool_calls_per_day": 12,
      "max_actions_per_investigation": 3,
