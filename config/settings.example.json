    "cognition_system0_options": {"thinking": false},
    "cognition_system1_model": "qwen2.5-7b-instruct-q4_k_m.gguf",
    "cognition_system1_options": {"thinking": false},
    "cognition_system2_model": "qwen2.5-7b-instruct-q4_k_m.gguf",
